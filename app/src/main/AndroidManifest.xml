<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required by Activity.registerScreenCaptureCallback (API 34+), which backs the
         Privacy & Security screenshot warning. Normal permission, no runtime prompt, and it
         grants no access to screenshot content - only a callback that one was taken. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <!-- Nearby Places (AI Chat) — only used when the user asks about nearby
         safe places; matches iOS's location usage scope (emergency SOS +
         safe-places search), not continuous tracking. Coarse is sufficient
         for a 2km nearby-search radius. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Invite-a-Care-Partner onboarding flow (InviteContactAccess/InvitePickContact
         steps); matches iOS's CNContactStore usage scope, only requested when
         the user chooses the contact-based invite path, never on app launch. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        Android 11+ package visibility: without this, `queryIntentActivities` for the
        Health Connect rationale action returns an empty list even on a phone that HAS
        health apps installed, which would make the import step wrongly report "no
        health app on this phone" for everyone. See
        `AndroidHealthConnectManager.availableSourceApps()`.
    -->
    <queries>
        <intent>
            <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name="team.sakhi.android.app.SakhiApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sakhi">
        <!-- Certificate pinning / network security config is a Phase 8 hardening
             item (matches KMM's pinning) — not wired yet, tracked in plan Section 8. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsApiKey}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="team.sakhi.android.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sakhi.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme, matches iOS's registered CFBundleURLSchemes "sakhi".
                 Parsed by the shared KMM `DeepLinkParser` via AndroidDeepLinkManager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sakhi" />
            </intent-filter>

            <!-- App Links (https). autoVerify requires a real assetlinks.json hosted
                 at each domain's /.well-known/ path before Android will auto-verify
                 ownership on a real device; not something this session can wire,
                 flagged in the plan file. The intent-filter itself is still correct
                 to register now regardless. sakhi-care.web.app is the real invite
                 share-link domain (Route.swift/AcceptInviteSheet.swift); sakhi.com
                 is iOS's registered Universal Links associated domain
                 (SakhiApp.entitlements' applinks:sakhi.com). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sakhi-care.web.app" />
                <data android:scheme="https" android:host="sakhi.com" />
            </intent-filter>
        </activity>
    </application>
</manifest>
