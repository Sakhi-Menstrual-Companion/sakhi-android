<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Real lint-hygiene fix (2026-07-16): this module calls permission-gated
         APIs (Vibrator.vibrate, NotificationManagerCompat.notify,
         FusedLocationProviderClient/LocationManager) but, until now, only the
         consuming `app` module's manifest declared the permissions; correct
         at runtime (the merged manifest always had them), but `core:platform`
         wasn't self-describing when lint-checked standalone. Declaring them
         here too is redundant with `app`'s manifest (harmlessly deduped by
         manifest merging) but makes this module correct regardless of which
         app consumes it. ACCESS_FINE_LOCATION deliberately NOT declared here,
         matching AndroidLocationProvider's real design: only coarse location
         is ever requested, sufficient for the 2km nearby-places radius. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Stay With Me (2026-09-13). While a walk is live her phone shares its position with the
         one person she asked, so this module now needs FINE location and a location-type
         foreground service. Only ever during a walk she started, stopped the moment she marks
         herself home. No background-location permission: the service is started from the
         screen, while the app is visible. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application>
        <!-- The icon and colour FCM uses for any message it draws itself (a notification
             payload while the app is closed). Ours are data-only and drawn by
             SakhiFirebaseMessagingService with the same two, so both paths look alike. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_sakhi" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/platform_notification_accent" />
        <service
            android:name=".StayWithMeLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM push transport (see SakhiFirebaseMessagingService kdoc), not
             wired to a live Firebase project yet, no google-services.json in
             this repo. Registered now so token wiring is real plumbing, not a
             stub, the moment that file lands. -->
        <service
            android:name=".SakhiFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SakhiPeriodWidgetReceiver"
            android:exported="false"
            android:label="@string/platform_notification_app_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sakhi_period_widget_info" />
        </receiver>
    </application>

</manifest>
