    <string name="onboarding_privacy_title">Your Privacy Comes First, Always.</string>
    <string name="onboarding_privacy_secure_title">Secure my data</string>
    <string name="onboarding_privacy_secure_description">Create an account to safely back up your data and access it anytime, across your devices.</string>
    <string name="onboarding_privacy_offline_title">Keep data on this device only</string>
    <string name="onboarding_privacy_offline_description">Your data stays on this device and won\'t be available if you change or lose your phone.</string>
    <string name="onboarding_terms_title">You\'re in</string>
    <string name="onboarding_terms_subtitle">Sakhi encrypts and protects everything you track.</string>
    <string name="onboarding_terms_agreement">I agree to the Terms &amp; Conditions and Privacy Policy</string>
    <string name="onboarding_terms_privacy_fallback">At Sakhi, protecting your privacy is our highest priority. Your data is securely stored and remains solely under your control.\n\nYour personal information, including cycle data, is never shared with third parties. We do not track, sell, or distribute your data. Only you have access to your information.\n\nBy using Sakhi, you retain full control over your data, and you may request its deletion at any time.\n\nWe use industry-standard encryption to safeguard your health information. Your cycle, health metrics, and personal details are protected end-to-end.\n\nSakhi will never sell your data to advertisers or data brokers. We believe your health is your business alone.</string>
    <string name="onboarding_intro_title">She Deserves to be Understood</string>
    <string name="onboarding_intro_subtitle">Whether it\'s your own health or someone you love, Sakhi is here.</string>
    <string name="onboarding_intro_feature_1_title">Logging in One Tap</string>
    <string name="onboarding_intro_feature_1_subtitle">A cramp, a mood, a long day. Tap it once and it\'s saved, so nothing slips and you don\'t have to carry it all in your head.</string>
    <string name="onboarding_intro_feature_2_title">Made for You, Not Everyone</string>
    <string name="onboarding_intro_feature_2_subtitle">Not the same tips the whole internet gets. What Sakhi suggests is shaped by your body, your cycle, your day.</string>
    <string name="onboarding_intro_feature_3_title">Never Do It Alone</string>
    <string name="onboarding_intro_feature_3_subtitle">Track just for you, or let someone you trust be there for you. You choose what they see, always.</string>
    <string name="onboarding_celebration_title">Welcome to Sakhi.</string>
    <string name="onboarding_celebration_subtitle">You\'re in. Everything you track is safe and backed up.</string>
    <string name="onboarding_celebration_button">Let\'s go!</string>
    <string name="onboarding_offline_warning_title">Before you continue offline</string>
    <string name="onboarding_offline_warning_subtitle">That\'s okay, you can use Sakhi without signing in. Just know that a few features won\'t be available.</string>
