    <string name="onboarding_partner_invite_prompt_subtitle">Pick one person who\'ll always know you\'re okay, and be the first to know if you\'re not.</string>
    <string name="onboarding_partner_invite_prompt_feature_1">They know you\'re okay. Even from far.</string>
