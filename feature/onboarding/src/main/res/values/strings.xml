    <string name="onboarding_days_info_period_title">Period Length</string>
    <string name="onboarding_days_info_period_explanation">Your period length is the number of days you bleed each cycle. It starts on the first day of noticeable bleeding and ends when it stops completely. A period lasting 3–8 days is considered normal, and the average is about 5 days.</string>
    <string name="onboarding_days_info_period_range">3–8 days</string>
    <string name="onboarding_days_info_period_average">5 days</string>
    <string name="onboarding_days_info_cycle_title">Cycle Length</string>
    <string name="onboarding_days_info_cycle_explanation">Your cycle length is the number of days from the first day of one period to the first day of the next. Every body is different, a cycle anywhere from 21 to 35 days is completely normal. The average is 28 days.</string>
    <string name="onboarding_days_info_cycle_range">21–35 days</string>
    <string name="onboarding_days_info_cycle_average">28 days</string>
