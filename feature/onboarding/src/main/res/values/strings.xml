    <string name="onboarding_host_description_mode_selection">This is the main branch point. KMM decides whether the remaining plan becomes the self path or the partner path.</string>
    <string name="onboarding_host_description_privacy">This step decides whether KMM should append auth, skip auth for an already-signed-in user, or branch into the offline warning.</string>
    <string name="onboarding_host_description_otp_verification">OTP success can continue normally, collapse into returning-user setup loading, or jump into the pending-invite acceptance path.</string>
    <string name="onboarding_host_description_setup_loading">This is the hydration handoff point before the app can route away from onboarding.</string>
    <string name="onboarding_host_description_partner_invite_prompt">This step can stay in the invite flow or switch into the care-upgrade path via a dedicated KMM intent.</string>
    <string name="onboarding_host_description_default">Placeholder content for this KMM-owned step. Visual parity and full field inputs land in the later onboarding UI pass.</string>
